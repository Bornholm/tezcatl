package web

import (
	"fmt"
	"net/url"
)

// TemplateFilter is the current filtering state of the templates page.
type TemplateFilter struct {
	Query string
	// Marking is "tous", "aucun", or one of the marking values.
	Marking string
}

type filterOption struct {
	Key   string
	Label string
}

func markFilters() []filterOption {
	return []filterOption{
		{Key: "tous", Label: "tous"},
		{Key: "aucun", Label: "aucun"},
		{Key: "ignore", Label: "ignore"},
		{Key: "normal", Label: "normal"},
		{Key: "symptomatic", Label: "symptomatic"},
	}
}

// TemplatesPage lists the learned templates with the marking feedback
// loop: what an operator flags here changes what the server reports.
templ TemplatesPage(nav Nav, context string, filter TemplateFilter, rows []TemplateRow, nextOffset int, more bool) {
	@Shell(nav) {
		<h1 class="page-title">Templates</h1>
		<p class="page-context">{ context }</p>
		<form
			class="filters"
			hx-get="/templates/rows"
			hx-target="#tpl-rows"
			hx-swap="innerHTML"
			hx-trigger="input changed delay:300ms from:find input.filter-input, submit"
		>
			<input
				class="filter-input"
				type="search"
				name="q"
				value={ filter.Query }
				placeholder="Filtrer sur le texte ou la partition"
				autocomplete="off"
			/>
			<input type="hidden" id="tpl-marking" name="marking" value={ filter.Marking }/>
			@TemplateChips(filter.Marking, false)
		</form>
		<div class="tpl-rows" id="tpl-rows">
			@TemplateBatch(filter, rows, nextOffset, more)
		</div>
	}
}

// TemplateChips is the marking filter. Each chip submits the form with
// marking-set; oob makes the fragment response move the active state
// and update the hidden field, so later keystrokes keep the filter.
templ TemplateChips(active string, oob bool) {
	<div
		class="filter-group"
		id="tpl-chips"
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, option := range markFilters() {
			<button
				type="submit"
				name="marking-set"
				value={ option.Key }
				class={ "filter-chip", templ.KV("active", option.Key == active) }
			>{ option.Label }</button>
		}
	</div>
}

// TemplateMarkingField re-syncs the hidden marking input after a chip
// click, out of band.
templ TemplateMarkingField(marking string) {
	<input type="hidden" id="tpl-marking" name="marking" value={ marking } hx-swap-oob="true"/>
}

// TemplateBatch is one page of rows plus the load-more button.
templ TemplateBatch(filter TemplateFilter, rows []TemplateRow, nextOffset int, more bool) {
	if len(rows) == 0 {
		<div class="rows-empty">Aucun template ne correspond au filtre.</div>
	}
	for _, row := range rows {
		@TemplateRowView(row)
	}
	if more {
		<button
			class="btn-ghost"
			hx-get={ fmt.Sprintf("/templates/rows?q=%s&marking=%s&offset=%d", url.QueryEscape(filter.Query), url.QueryEscape(filter.Marking), nextOffset) }
			hx-target="this"
			hx-swap="outerHTML"
		>Charger plus</button>
	}
}

templ TemplateRowView(row TemplateRow) {
	<div class="tpl-row">
		<div class="tpl-main">
			<div class="tpl-text">
				@MaskedText(row.Parts)
			</div>
			<div class="tpl-sub">{ row.SubLabel }</div>
		</div>
		<form class="tpl-actions" hx-post="/templates/mark" hx-target="closest .tpl-row" hx-swap="outerHTML">
			<input type="hidden" name="template" value={ row.Template }/>
			<input type="hidden" name="partition" value={ row.Partition }/>
			<input type="hidden" name="size" value={ fmt.Sprint(row.Size) }/>
			<button type="submit" name="marking" value="ignore" class={ "chip-btn", templ.KV("active", row.Marking == "ignore") }>ignorer</button>
			<button type="submit" name="marking" value="normal" class={ "chip-btn", templ.KV("active", row.Marking == "normal") }>normal</button>
			<button type="submit" name="marking" value="symptomatic" class={ "chip-btn", templ.KV("active", row.Marking == "symptomatic") }>symptomatique</button>
			<button type="submit" name="marking" value="" class="chip-btn">effacer</button>
		</form>
	</div>
}
