package web

import "fmt"

// DetailPage tells one incident's story: trigger, correlated changes,
// evidence, then the raw material in folds. explain carries the state
// of the generated explanation; its Model is empty when no LLM is
// configured, and the Explain button simply does not exist.
templ DetailPage(nav Nav, detail IncidentDetail, explain ExplainView) {
	@Shell(nav) {
		<a class="back" href="/">← Incidents</a>
		<div class="detail-head">
			<h1 class="detail-title">{ detail.Title }</h1>
			@ExplainButtonSlot(explain, false)
		</div>
		<div class="detail-meta">
			@SeverityChip(detail.Severity)
			<span class="meta-mono">{ detail.ConfLabel }</span>
			<span class="meta-mono">{ detail.AbsPeriod }</span>
			<span class="meta-mono">{ detail.Services }</span>
		</div>
		<div id="explain-zone">
			@ExplainZone(explain)
		</div>
		<section class="sec">
			<h2 class="sec-title">Déclencheur</h2>
			<p class="trigger-summary">{ detail.TriggerSummary }</p>
			<p class="trigger-meta">{ detail.TriggerTime } · { detail.TriggerKind }</p>
			if detail.TriggerMark != nil {
				@MarkShortcut(*detail.TriggerMark)
			}
			<p class="sec-note">Premier dans le temps ne veut pas dire cause. Le serveur ne connaît pas la causalité.</p>
		</section>
		if len(detail.Changes) > 0 {
			<section class="sec">
				<h2 class="sec-title">Changements corrélés</h2>
				<div class="changes">
					for _, change := range detail.Changes {
						<div class="change">
							<div class="change-line">
								<span>{ change.Type }</span>
								if change.Version != "" {
									<span class="change-version">{ change.Version }</span>
								}
								<span class="change-delta">{ change.Delta }</span>
							</div>
						</div>
					}
				</div>
				<p class="sec-note">
					Coïncidence dans le temps, et rien d'autre. Le rapprochement est
					fait sur l'horodatage ; aucun lien n'a été établi entre
					if len(detail.Changes) > 1 {
						ces changements
					} else {
						ce changement
					}
					et l'anomalie.
				</p>
			</section>
		}
		<section class="sec">
			<h2 class="sec-title">Preuves</h2>
			<div class="evidence">
				for _, evidence := range detail.Evidence {
					<div class="evidence-item">
						<div class="evidence-meta">
							<span class="evidence-kind">{ evidence.Kind }</span>
							<span class="evidence-src">{ evidence.Source }</span>
							<span class="evidence-src">{ evidence.CountLabel }</span>
							<span class="evidence-dim">{ evidence.Span }</span>
							<span class="evidence-dim">score max { evidence.MaxScore }</span>
						</div>
						<p class="evidence-summary">{ evidence.Summary }</p>
						if evidence.Mark != nil {
							@MarkShortcut(*evidence.Mark)
						}
					</div>
				}
			</div>
		</section>
		if len(detail.ContextLines) > 0 {
			<details class="fold">
				<summary><span class="caret"></span>Contexte · { Plural(len(detail.ContextLines), "ligne") } de log autour du déclencheur</summary>
				<div class="ctx">
					for _, line := range detail.ContextLines {
						<div class="ctx-line">{ line }</div>
					}
				</div>
			</details>
		}
		<details class="fold">
			<summary><span class="caret"></span>Événements sous-jacents · { fmt.Sprint(len(detail.Events)) }</summary>
			<div class="events">
				for _, event := range detail.Events {
					<div class="event">
						<span class="event-time">{ event.Time }</span>
						<span class={ "event-kind", "fg-" + event.Class }>{ event.Kind }</span>
						<span class="event-summary">{ event.Summary }</span>
					</div>
				}
			</div>
		</details>
	}
}

// ExplainButtonSlot holds the Explain button, present only while
// nothing has been asked yet. oob makes it an htmx out-of-band swap,
// for the responses that change the button's presence.
templ ExplainButtonSlot(view ExplainView, oob bool) {
	<div
		id="explain-btn-slot"
		if oob {
			hx-swap-oob="true"
		}
	>
		if view.Model != "" && view.State == ExplainIdle {
			@ExplainButton(view.IncidentID)
		}
	</div>
}

templ ExplainButton(id string) {
	<button
		class="btn-accent"
		hx-post={ "/incidents/" + id + "/explain" }
		hx-target="#explain-zone"
		hx-swap="innerHTML"
		hx-disabled-elt="this"
	>Explain</button>
}

// ExplainZone renders whichever state the generation is in.
templ ExplainZone(view ExplainView) {
	switch view.State {
		case ExplainPendingState:
			@ExplainPending(view)
		case ExplainDone:
			@ExplainPanel(view)
	}
}

// ExplainPending is the panel shown while the model is answering. The
// generation runs on the server, past the request that started it, and
// this panel polls for the result: a model that takes two minutes
// would otherwise die with the first reverse proxy timeout.
templ ExplainPending(view ExplainView) {
	<div
		class="explain"
		hx-get={ "/incidents/" + view.IncidentID + "/explain/status" }
		hx-trigger="load delay:2s"
		hx-target="#explain-zone"
		hx-swap="innerHTML"
	>
		<div class="explain-head">
			<div class="explain-tag">
				<span class="diamond"></span>
				<span class="explain-label">Explication générée</span>
			</div>
			<div class="explain-actions">
				@explainDismiss(view.IncidentID)
			</div>
		</div>
		<div class="explain-loading">
			<span class="pulse"></span>
			{ view.Model } · rapport envoyé, réponse en cours
		</div>
	</div>
}

// ExplainPanel is the model's answer, or its failure, with the actions
// to regenerate or dismiss.
templ ExplainPanel(view ExplainView) {
	<div class="explain">
		<div class="explain-head">
			<div class="explain-tag">
				<span class="diamond"></span>
				<span class="explain-label">Explication générée</span>
			</div>
			<div class="explain-actions">
				<button
					class="btn-small"
					hx-post={ "/incidents/" + view.IncidentID + "/explain" }
					hx-target="#explain-zone"
					hx-swap="innerHTML"
					hx-disabled-elt="this"
				>Régénérer</button>
				@explainDismiss(view.IncidentID)
			</div>
		</div>
		if view.Error != "" {
			<div class="explain-error">
				<p>Le modèle est injoignable.</p>
				<p class="muted">
					Vérifiez, dans le YAML d'itztli : la clé
					<span class="code-inline">genai.provider</span>, la validité de
					<span class="code-inline">genai.api_key</span>, et l'accès réseau
					sortant vers le fournisseur.
				</p>
				<p class="err-detail">{ view.Error }</p>
			</div>
		} else {
			<p class="explain-text">{ view.Text }</p>
			<p class="explain-disclaimer">
				Interprétation produite par un modèle de langage à partir du
				rapport de l'incident. Elle peut se tromper et n'est pas conservée.
			</p>
		}
	</div>
}

templ explainDismiss(id string) {
	<button
		class="btn-small"
		hx-get={ "/incidents/" + id + "/explain/reset" }
		hx-target="#explain-zone"
		hx-swap="innerHTML"
	>Rejeter</button>
}

// MarkShortcut lets a reader answer the server where the judgement is
// actually made: this pattern is noise, or it is a symptom worth
// reporting. It is the same feedback loop as `tezcatl mark`, one click
// from the incident that raised the question.
templ MarkShortcut(target MarkTarget) {
	<form class="mark-shortcut" hx-post="/incidents/mark" hx-target="this" hx-swap="outerHTML">
		<input type="hidden" name="kind" value={ target.Kind }/>
		<input type="hidden" name="target" value={ target.Value }/>
		<span class="mark-label">marquer</span>
		if target.IsTemplate() {
			<button
				type="submit"
				name="marking"
				value="symptomatic"
				class={ "chip-btn", templ.KV("active", target.Marking == "symptomatic") }
			>symptomatique</button>
		}
		<button
			type="submit"
			name="marking"
			value="ignore"
			title={ target.SilencedTitle() }
			class={ "chip-btn", templ.KV("active", target.Silenced()) }
		>ignorer</button>
		<button
			type="submit"
			name="marking"
			value=""
			class={ "chip-btn", templ.KV("active", target.Marking == "") }
		>défaut</button>
	</form>
}
