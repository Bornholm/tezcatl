package web

import "fmt"

// IncidentsPage is the home dashboard: the latest incidents first,
// narrowed by the filter the reader chose.
templ IncidentsPage(nav Nav, context string, filter IncidentFilter, cards []IncidentCard, nextOffset int, more bool, empty *EmptyState) {
	@Shell(nav) {
		<h1 class="page-title">Derniers incidents</h1>
		<p class="page-context">{ context }</p>
		@IncidentFilters(nav, filter)
		if empty != nil {
			@EmptyStateView(*empty)
		} else {
			<div class="cards" id="incident-cards">
				@IncidentBatch(filter, cards, nextOffset, more)
			</div>
		}
	}
}

// IncidentFilters is a plain GET form: every chip is a submit button,
// so the filter ends up in the URL and the page can be bookmarked or
// shared as it is read.
templ IncidentFilters(nav Nav, filter IncidentFilter) {
	<form class="filters-bar" method="get" action="/">
		<input type="hidden" name="range" value={ durationParam(filter.Range) }/>
		<input type="hidden" name="severity" value={ filter.Severity }/>
		<input type="hidden" name="gap" value={ durationParam(filter.Gap) }/>
		@filterRow("période", "range-set", filter.RangeChoices(nav.Window))
		@filterRow("sévérité", "severity-set", filter.SeverityChoices())
		@filterRow("regroupement", "gap-set", filter.GapChoices())
	</form>
}

templ filterRow(label string, field string, choices []Choice) {
	<div class="filter-row">
		<span class="filter-label">{ label }</span>
		<div class="filter-group">
			for _, choice := range choices {
				<button
					type="submit"
					name={ field }
					value={ choice.Value }
					class={ "filter-chip", templ.KV("active", choice.Active) }
				>{ choice.Label }</button>
			}
		</div>
	</div>
}

// IncidentBatch is one page of cards plus, when the list goes on, the
// button that fetches the next batch in place.
templ IncidentBatch(filter IncidentFilter, cards []IncidentCard, nextOffset int, more bool) {
	for _, card := range cards {
		@IncidentCardView(card)
	}
	if more {
		<button
			class="btn-ghost"
			hx-get={ fmt.Sprintf("/incidents/rows?%s&offset=%d", filter.Query(), nextOffset) }
			hx-target="this"
			hx-swap="outerHTML"
		>Charger les incidents plus anciens</button>
	}
}

templ IncidentCardView(card IncidentCard) {
	<a class="card" href={ "/incidents/" + card.ID }>
		<div class="card-head">
			<div class="card-title">{ card.Title }</div>
			@SeverityChip(card.Severity)
		</div>
		<div class="card-trigger">
			<div class="trigger-kind">{ card.TriggerKind }</div>
			<div class="trigger-text">
				@MaskedText(card.TriggerParts)
			</div>
		</div>
		<div class="card-meta">
			<span class="card-services">{ card.Services }</span>
			<span>{ card.RelPeriod }</span>
			<span>{ card.EventsLabel }</span>
			if card.ChangeLabel != "" {
				<span class="card-change"><span class="dot"></span>{ card.ChangeLabel }</span>
			}
		</div>
	</a>
}

templ SeverityChip(severity Severity) {
	<div class={ "sev", "sev-" + severity.Class }>
		<span class="sev-glyph">{ severity.Glyph }</span>
		<span class="sev-word">{ severity.Word }</span>
	</div>
}

// MaskedText renders a template with its placeholders highlighted, so
// nobody reads a mask as a value.
templ MaskedText(parts []Part) {
	for _, part := range parts {
		if part.Mask {
			<span class="mask">{ part.Text }</span>
		} else {
			<span>{ part.Text }</span>
		}
	}
}

// EmptyStateView says what "no incident" means and, honestly, what it
// does not.
templ EmptyStateView(empty EmptyState) {
	<div class="empty">
		<p class="empty-title">Aucun incident avec ce filtre.</p>
		<p class="empty-text">
			Élargissez la période ou la sévérité pour en voir davantage. Si
			la vue la plus large reste vide, c'est que rien ne s'écarte de ce
			que le serveur a appris.
			Ce n'est pas une garantie que les services vont bien : une panne
			uniforme, une série en apprentissage ou un motif marqué comme
			ignoré ne produisent pas d'écart.
		</p>
		<p class="empty-stats">{ empty.StatsLabel() }</p>
	</div>
}
